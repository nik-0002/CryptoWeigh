# Copy this file to ".env.local" and fill in every value.
# On Vercel, add the same names under Settings > Environment Variables.

# From Supabase: Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-secret-key-here

# Password the ESP32 sends. Make one with:  openssl rand -hex 24
DEVICE_API_KEY=

# Admin login for the website
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs the login cookie. Make one with:  openssl rand -hex 32
SESSION_SECRET=

# Optional
DISPLAY_TZ=Asia/Kolkata
# Only accept these chip serial numbers (comma separated). Leave empty at first.
ALLOWED_DEVICE_IDS=
# Set to false to skip the SHA-256 check
VERIFY_HASH=true
